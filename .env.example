# Local Postgres used by `prisma migrate dev` / `next dev` / `npm test`.
DATABASE_URL="postgresql://user@localhost:5432/nobel_quiz_dev?schema=public"

# Railway's PUBLIC connection string (the one with a `proxy.rlwy.net` host),
# not the `*.railway.internal` one — that only resolves from inside another
# Railway service. Used for `prisma migrate deploy` against the real deployed
# database. See METHODS.md, "Credentials arrive" section.
PRODUCTION_DATABASE_URL="postgresql://postgres:password@xxxxx.proxy.rlwy.net:PORT/railway"

# https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional. Defaults to Resend's shared onboarding@resend.dev sender if unset
# (see METHODS.md — the account's custom domain isn't verified yet).
# EMAIL_FROM_ADDRESS="Nobel Quiz <noreply@yourdomain.com>"

# Optional. Used to build absolute links in verification/reset emails.
# Defaults to http://localhost:3000 if unset.
# APP_BASE_URL="https://nobel-quiz.up.railway.app"
